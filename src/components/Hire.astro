---
import { EMAIL, FORM_ACCESS_KEY } from "../data/site";

const services = [
  {
    t: "Extensiones de Chrome",
    d: "Como Vendly: panel lateral, lectura de páginas y datos que se quedan en el navegador.",
  },
  {
    t: "Apps web a medida",
    d: "Paneles, CRMs y sistemas internos con Angular y NestJS.",
  },
  {
    t: "Integraciones con APIs",
    d: "Mensajería, pagos y plataformas de terceros conectadas a tu negocio.",
  },
  { t: "Apps Android", d: "Herramientas móviles nativas con Kotlin." },
  {
    t: "Automatizar lo manual",
    d: "Si lo haces a mano todos los días, casi seguro se puede programar.",
  },
];
const stack = [
  "TypeScript",
  "Angular",
  "NestJS",
  "PostgreSQL",
  "SQLite",
  "Chrome MV3",
  "Kotlin",
];
---

<section class="hire" id="a-tu-medida">
  <div class="container hire-grid">
    <div class="left">
      <p class="eyebrow" data-reveal>A tu <b>medida</b></p>
      <h2 data-split>Vendly lo hice yo. Tu idea puede ser lo siguiente.</h2>
      <p class="intro" data-reveal>
        Soy programador. Vendly nació de ver cómo se pierden pedidos en un live,
        y lo construí de noche, en público. Si tu negocio necesita su propia
        herramienta, hablemos.
      </p>

      <div class="contacts" data-reveal>
        <a
          class="contact"
          href={`mailto:${EMAIL}`}
          data-copy-email
          title="Copiar correo"
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path
              d="m4 7 8 6 8-6"></path></svg
          >
          {EMAIL}
        </a>
      </div>

      <div
        class="thread"
        data-reveal
        aria-label="Un comentario que ya me han hecho"
      >
        <div class="bubble them">
          <span class="who mono">@alguien</span>con claude, pura IA 🙄
        </div>
        <div class="bubble me">
          <span class="who mono">yo</span>Sí, y programo desde antes de que
          existiera 😎
        </div>
      </div>

      <ul class="services" data-reveal>
        {
          services.map((s) => (
            <li>
              <strong>{s.t}</strong>
              <span>{s.d}</span>
            </li>
          ))
        }
      </ul>

      <ul class="stack mono" data-reveal aria-label="Tecnologías">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>

    <aside class="card" data-reveal>
      <h3>Cuéntame qué necesitas</h3>
      <p class="sub">Con un par de líneas me alcanza para responderte.</p>

      <form id="leadForm" novalidate>
        <input
          type="checkbox"
          name="botcheck"
          class="trap"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <label>
          <span>Tu nombre</span>
          <input
            name="fullName"
            type="text"
            autocomplete="name"
            required
            placeholder="Cómo te llamas"
          />
        </label>
        <label>
          <span>Correo o WhatsApp</span>
          <input
            name="contact"
            type="text"
            autocomplete="email"
            required
            placeholder="Dónde te respondo"
          />
        </label>
        <label>
          <span>¿Qué necesitas?</span>
          <textarea
            name="message"
            rows="4"
            required
            placeholder="Ej. un panel para controlar los pedidos de mi tienda"
          ></textarea>
        </label>
        <p class="err" id="leadErr" role="alert"></p>
        <button class="btn btn-primary" type="submit" id="leadSend"
          >Enviar mensaje</button
        >
      </form>

      <div class="ok" id="leadOk" role="status" hidden>
        <strong>Listo, recibí tu mensaje.</strong>
        <span>Te respondo por el medio que dejaste.</span>
      </div>

      <p class="fine">
        {
          FORM_ACCESS_KEY
            ? "Tu mensaje me llega por correo mediante un servicio de formularios y no se usa para nada más. "
            : "Se abre Gmail con el mensaje listo para enviar. "
        }
        También puedes escribirme a
        <a href={`mailto:${EMAIL}`} data-copy-email> {EMAIL}</a> (al tocarlo se copia).
      </p>
    </aside>
  </div>
</section>

<script define:vars={{ EMAIL, FORM_ACCESS_KEY }} is:inline>
  window.__lead = { email: EMAIL, key: FORM_ACCESS_KEY };
</script>

<style>
  .hire {
    padding: clamp(80px, 12vw, 160px) 0;
    background: var(--paper);
    color: var(--ink);
  }
  .hire :global(em) {
    color: var(--pink-deep);
  }
  .hire-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .left {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .eyebrow {
    color: #55576a;
  }
  .eyebrow b {
    color: var(--pink-deep);
  }
  h2 {
    font-size: clamp(2.4rem, 5.2vw, 4.8rem);
    line-height: 0.95;
  }
  .intro {
    max-width: 32em;
    color: #3f414c;
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
  }
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .contact {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  .contact:hover {
    background: var(--ink);
    color: #fff;
    transform: translateY(-2px);
  }
  .thread {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 30em;
  }
  .bubble {
    padding: 14px 20px;
    border-radius: 22px;
    font-weight: 600;
    font-size: 1.05rem;
  }
  .who {
    display: block;
    margin-bottom: 2px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }
  .them {
    align-self: flex-start;
    background: #e2e3ea;
    border-bottom-left-radius: 6px;
  }
  .me {
    align-self: flex-end;
    background: var(--pink-deep);
    color: #fff;
    border-bottom-right-radius: 6px;
  }
  .services {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  .services li {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid #d0d1d8;
    transition:
      padding 0.3s,
      background-color 0.3s;
  }
  .services li:hover {
    padding-left: 14px;
    background: rgba(254, 44, 85, 0.07);
  }
  .services strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .services span {
    color: #3f414c;
    font-size: 0.98rem;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stack li {
    padding: 6px 12px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .card {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: #fff;
    box-shadow: 0 40px 100px -30px rgba(22, 24, 35, 0.6);
  }
  .card h3 {
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
  }
  .sub {
    color: #c6c7ce;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 8px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label span {
    color: #c6c7ce;
    font-size: 0.85rem;
    font-weight: 600;
  }
  input,
  textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1.5px solid #35353e;
    border-radius: 12px;
    background: #0e0e11;
    color: #fff;
    font-size: 1rem;
    resize: vertical;
    transition: border-color 0.2s;
  }
  input::placeholder,
  textarea::placeholder {
    color: #7c7e8a;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--pink);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--cyan);
    outline-offset: 2px;
  }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .ok {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px;
    border: 1.5px solid #4cc38a;
    border-radius: 14px;
    background: rgba(76, 195, 138, 0.12);
  }
  .ok[hidden] {
    display: none;
  }
  .ok strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .ok span {
    color: #c6c7ce;
  }
  .card .btn[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .err {
    min-height: 1.4em;
    color: #ff8aa0;
    font-size: 0.9rem;
  }
  .card .btn {
    width: 100%;
  }
  .fine {
    color: #9a9ba6;
    font-size: 0.88rem;
  }
  .fine a {
    display: inline-block;
    padding: 8px 0;
    color: #fff;
  }
  @media (max-width: 960px) {
    .hire-grid {
      grid-template-columns: 1fr;
    }
    .card {
      position: static;
    }
    .services li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
