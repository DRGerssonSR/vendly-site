---
import { asset } from '../data/site'

const items = [
  { id: 'demo-1', t: 'Del caos al orden', d: 'Lo que le pasa al chat de un live, y cómo queda con Vendly.' },
  { id: 'demo-2', t: 'Un pedido en 8 segundos', d: 'De un comentario a un pedido, con cronómetro.' },
  { id: 'demo-3', t: 'Cobros y clientes', d: 'Marca pagado y guarda alias y notas de cada cliente.' },
]
---

<section class="videos" id="en-accion">
  <div class="container">
    <div class="head">
      <p class="eyebrow" data-reveal>En acción</p>
      <h2 data-split>Míralo funcionar en un live.</h2>
    </div>

    <div class="phones">
      {items.map((v) => (
        <figure class="phone-wrap" data-reveal>
          <div class="phone">
            <video muted loop playsinline preload="none" poster={asset(`video/${v.id}.jpg`)} aria-label={v.t}>
              <source src={asset(`video/${v.id}.mp4`)} type="video/mp4" />
            </video>
          </div>
          <figcaption>
            <strong>{v.t}</strong>
            <span>{v.d}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .videos {
    padding: clamp(80px, 12vw, 160px) 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, rgba(254, 44, 85, 0.12), transparent 70%), var(--bg);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  h2 {
    max-width: 14em;
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
  }
  .phones {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 4vw, 56px);
    align-items: start;
  }
  .phone-wrap {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .phone-wrap:nth-child(2) {
    margin-top: clamp(0px, 5vw, 72px);
  }
  .phone-wrap:nth-child(3) {
    margin-top: clamp(0px, 10vw, 144px);
  }
  .phone {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border: 8px solid #26262d;
    border-radius: 36px;
    background: #000;
    box-shadow:
      0 40px 90px -30px rgba(0, 0, 0, 0.8),
      0 0 0 1px #35353e,
      0 0 80px -20px rgba(254, 44, 85, 0.35);
    transition:
      transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.5s;
  }
  .phone:hover {
    transform: translateY(-8px) rotate(-1deg);
    box-shadow:
      0 50px 100px -30px rgba(0, 0, 0, 0.9),
      0 0 0 1px #35353e,
      0 0 110px -10px rgba(254, 44, 85, 0.55);
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  figcaption strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  figcaption span {
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 820px) {
    .phones {
      display: flex;
      gap: 18px;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 12px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .phone-wrap {
      flex: 0 0 74%;
      scroll-snap-align: center;
      margin-top: 0 !important;
    }
  }
</style>
